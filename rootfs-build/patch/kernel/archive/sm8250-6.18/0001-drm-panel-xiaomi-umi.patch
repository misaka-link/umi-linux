From 22647d41687534ca48b6173a5ab753f6e6d67a9b Mon Sep 17 00:00:00 2001
From: umi-mainline <umi@local>
Date: Sun, 25 Oct 2026 05:16:13 +0000
Subject: [PATCH] drm/panel: add Xiaomi Mi 10 (umi) AMOLED panel driver

---
 drivers/gpu/drm/panel/Kconfig            |  15 +
 drivers/gpu/drm/panel/Makefile           |   1 +
 drivers/gpu/drm/panel/panel-xiaomi-umi.c | 931 +++++++++++++++++++++++
 3 files changed, 947 insertions(+)
 create mode 100644 drivers/gpu/drm/panel/panel-xiaomi-umi.c

diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index 407c5f6..5eee9c0 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -1147,6 +1147,21 @@ config DRM_PANEL_WIDECHIPS_WS2401
 	  480x800 display controller used in panels such as Samsung LMS380KF01.
 	  This display is used in the Samsung Galaxy Ace 2 GT-I8160 (Codina).
 
+config DRM_PANEL_XIAOMI_UMI
+	tristate "Xiaomi Mi 10 (umi) AMOLED panel"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	select DRM_DISPLAY_DSC_HELPER
+	help
+	  Say Y here if you want to enable support for the AMOLED panel used in
+	  the Xiaomi Mi 10 (umi / M2001J2C), an SM8250 device.
+
+	  The panel runs in command mode with DSC.  Timings, the DCS init
+	  sequences and the backlight range are read from the board DT, so a
+	  single driver covers every panel variant Xiaomi shipped in this
+	  phone (Samsung J2, CSOT, ...).
+
 config DRM_PANEL_XINPENG_XPP055C272
 	tristate "Xinpeng XPP055C272 panel driver"
 	depends on OF
diff --git a/drivers/gpu/drm/panel/Makefile b/drivers/gpu/drm/panel/Makefile
index 3615a76..394499a 100644
--- a/drivers/gpu/drm/panel/Makefile
+++ b/drivers/gpu/drm/panel/Makefile
@@ -115,4 +115,5 @@ obj-$(CONFIG_DRM_PANEL_VISIONOX_RM692E5) += panel-visionox-rm692e5.o
 obj-$(CONFIG_DRM_PANEL_VISIONOX_VTDR6130) += panel-visionox-vtdr6130.o
 obj-$(CONFIG_DRM_PANEL_VISIONOX_R66451) += panel-visionox-r66451.o
 obj-$(CONFIG_DRM_PANEL_WIDECHIPS_WS2401) += panel-widechips-ws2401.o
+obj-$(CONFIG_DRM_PANEL_XIAOMI_UMI) += panel-xiaomi-umi.o
 obj-$(CONFIG_DRM_PANEL_XINPENG_XPP055C272) += panel-xinpeng-xpp055c272.o
diff --git a/drivers/gpu/drm/panel/panel-xiaomi-umi.c b/drivers/gpu/drm/panel/panel-xiaomi-umi.c
new file mode 100644
index 0000000..dd831cc
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-xiaomi-umi.c
@@ -0,0 +1,931 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * panel-xiaomi-umi.c — Xiaomi Mi 10 (umi) AMOLED panel driver
+ *
+ * 这块机器下游有 28 个面板变体（华星 CSOT 的 j2_42 / l3a / l10a 系列，三星的 j2_38 系列），
+ * 每个变体的时序、DSC 参数、初始化序列都不一样。为每个变体写一个 C 驱动既不可维护，
+ * 也容易抄错一个字节。所以这里换一种做法：
+ *
+ *   ★ 驱动里**不含任何面板数据**，全部从设备树读。
+ *     换屏 = 改 DTS 里哪个变体 status = "okay"，不用重新编译驱动。
+ *
+ * ★★★ 电压安全约定（硬性，不许违反）★★★
+ *   1. 本驱动**不设置任何 regulator 电压**，只做 regulator_enable()/disable()。
+ *   2. 实际上默认连 enable 都不做：umi 的屏供电（vddio 1.8V / vci 3.0V）在下游
+ *      DT 里分别是 pm8150_l14（qcom,proxy-consumer-enable）和 display_gpio_regulator_vci
+ *      （regulator-boot-on），**ABL 起来之后就已经是开的**。内核只要不去关它就行。
+ *      所以 DTS 里不给 xiaomi,supply-names，驱动就完全不碰供电。
+ *   3. 亮度默认走 DT 里的 bl-min（通常是 1），**不会**自己拉满。
+ *   4. DSC/时序只做"照抄下游 DTB"的事，不做任何推算。
+ *
+ * 初始化序列格式 = 高通下游的 DSI 包流（逐字节）：
+ *      [dtype][last][vc][ack][wait(1B)][len(2B BE)][payload...]      共 7 字节头
+ *   来自 downstream-kernel/drivers/video/fbdev/msm/mdss_dsi_cmd.h 的
+ *   struct dsi_ctrl_hdr（__packed）。等待时间单位是**毫秒**
+ *   （下游 mdss_dsi_host.c: usleep_range(wait * 1000, wait * 1000)），
+ *   和 msleep(wait) 等价。
+ *
+ * ★ last 不是终止符！下游解析循环只按 dlen 走完整段。
+ *   实测 j2_mp_42_02_0b 的 on-command 是 59 个包、652 字节，全部 dtype=0x05/0x15/0x39，
+ *   **里面没有 PPS 包**（没有 0x0a）。所以 DSC 的 PPS 必须由本驱动按
+ *   qcom,mdss-dsc-* 那组属性自己生成再发出去。
+ *
+ * dtype 语义（见 downstream mdss_dsi_cmd.h）：
+ *   0x05 DCS_WRITE   短写、0 参数（DT 里后面那个 0x00 是填充，不是参数！）
+ *   0x15 DCS_WRITE1  短写、1 参数
+ *   0x39 DCS_LWRITE  长写
+ *   0x03/0x13/0x23/0x29  通用写（0x29 是长写）
+ *   0x07 COMPRESSION_MODE  → mipi_dsi_compression_mode()
+ *   0x0a PPS              → mipi_dsi_picture_parameter_set()
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+#include <linux/uaccess.h>
+
+#include <drm/display/drm_dsc.h>
+#include <drm/display/drm_dsc_helper.h>
+#include <drm/drm_connector.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+
+struct umi_panel_cfg {
+	u32 width;			/* 像素 */
+	u32 height;
+	u32 framerate;
+	u32 hfp, hbp, hpw, hskew;
+	u32 vfp, vbp, vpw;
+	u32 width_mm, height_mm;
+	u32 clockrate;			/* DSI bit clock，Hz */
+
+	const u8 *on_seq;
+	int on_seq_len;
+	const u8 *off_seq;
+	int off_seq_len;
+	/*
+	 * ★ reset-sequence 是**大端 32 位单元**：<电平 延时ms 电平 延时ms ...>
+	 *   必须按 u32 读（be32_to_cpup），不能按字节读 —— 按字节读出来的全是 0。
+	 *   这是我踩过的坑：读到 0 就变成「拉低 0ms、拉高 0ms」，面板根本没复位，
+	 *   加了这个脚之后反而比不加还黑。
+	 */
+	u32 reset_seq[8];
+	int reset_seq_len;		/* 元素个数（u32） */
+
+	bool dsc;
+	u32 dsc_slice_width, dsc_slice_height, dsc_slice_per_pkt;
+	u32 dsc_bpc, dsc_bpp, dsc_version;
+	bool dsc_block_pred;
+	struct drm_dsc_config dsc_cfg;
+
+	u32 bl_min, bl_max;
+	u32 panel_id[2];
+
+	/* 调试开关：只 probe、不碰面板（不拉 reset、不发任何 DSI 包、不写背光） */
+	bool no_init;
+};
+
+struct umi_panel {
+	struct drm_panel panel;
+
+struct mipi_dsi_device *dsi;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data *supplies;
+	int num_supplies;
+	struct backlight_device *bl;
+	struct umi_panel_cfg cfg;
+};
+
+/*
+ * Set once this driver has attached the panel.  The touch driver waits for it
+ * so its analog front end does not start sampling before the display has
+ * established its rails (that is the order MIUI runs in).
+ */
+int umi_panel_ready;
+EXPORT_SYMBOL_GPL(umi_panel_ready);
+
+static inline struct umi_panel *to_umi_panel(struct drm_panel *p)
+{
+	return container_of(p, struct umi_panel, panel);
+}
+
+/* ------------------------------------------------------------------ 序列发送 */
+
+#define UMI_DSI_HDR_LEN		7
+#define UMI_DSI_HDR_WAIT_OFF	4
+#define UMI_DSI_HDR_DLEN_OFF	5
+
+/* 下游 DTYPE（mdss_dsi_cmd.h） */
+#define DT_GEN_WRITE		0x03
+#define DT_GEN_READ		0x04
+#define DT_DCS_WRITE		0x05
+#define DT_DCS_READ		0x06
+#define DT_COMPRESSION_MODE	0x07
+#define DT_GEN_LREAD		0x09
+#define DT_PPS			0x0a
+#define DT_GEN_WRITE1		0x13
+#define DT_DCS_WRITE1		0x15
+#define DT_GEN_READ1		0x1a
+#define DT_DCS_READ1		0x1c
+#define DT_GEN_WRITE2		0x23
+#define DT_GEN_LWRITE		0x29
+#define DT_DCS_LWRITE		0x39
+
+static int umi_panel_send_one(struct umi_panel *ctx, u8 dtype,
+			      const u8 *pl, int plen)
+{
+	struct mipi_dsi_device *dsi = ctx->dsi;
+
+	switch (dtype) {
+	case DT_COMPRESSION_MODE:
+		/* payload = <0x01 0x00>：0x01 表示启用 DSC */
+		return mipi_dsi_compression_mode(dsi, pl[0] & 1);
+
+	case DT_PPS:
+		if (plen != sizeof(struct drm_dsc_picture_parameter_set)) {
+			dev_err(&dsi->dev, "PPS length %d != %zu\n", plen,
+				sizeof(struct drm_dsc_picture_parameter_set));
+			return -EINVAL;
+		}
+		return mipi_dsi_picture_parameter_set(
+			dsi, (const struct drm_dsc_picture_parameter_set *)pl);
+
+	case DT_GEN_WRITE:
+	case DT_GEN_WRITE1:
+	case DT_GEN_WRITE2:
+	case DT_GEN_LWRITE:
+		return mipi_dsi_generic_write(dsi, pl, plen);
+
+	/*
+	 * 0x05 是「短写、0 参数」：DT 里 payload 写成 <11 00>，
+	 * 那个 00 只是 32 位单元对齐的填充，不是参数。
+	 * 直接喂给 mipi_dsi_dcs_write_buffer() 会变成「短写 + 1 参数 0x00」——
+	 * 面板对 0x11/0x29/0x2c 多收一个参数的行为不可控，所以这里显式区分。
+	 */
+	case DT_DCS_WRITE:
+		if (plen < 1)
+			return -EINVAL;
+		return mipi_dsi_dcs_write(dsi, pl[0], NULL, 0);
+
+	case DT_DCS_WRITE1:
+	case DT_DCS_LWRITE:
+		if (plen < 1)
+			return -EINVAL;
+		return mipi_dsi_dcs_write(dsi, pl[0], pl + 1, plen - 1);
+
+	default:
+		dev_warn(&dsi->dev, "unknown dtype 0x%02x, skipped\n", dtype);
+		return 0;
+	}
+}
+
+static int umi_panel_send_seq(struct umi_panel *ctx, const char *what,
+			      const u8 *seq, int len)
+{
+	int i = 0, npkt = 0, nskip = 0;
+
+	if (!seq || len <= 0)
+		return 0;
+
+	while (i + UMI_DSI_HDR_LEN <= len) {
+		u8 dtype = seq[i + 0];
+		u8 wait = seq[i + UMI_DSI_HDR_WAIT_OFF];
+		u16 plen = (seq[i + UMI_DSI_HDR_DLEN_OFF] << 8) |
+			   seq[i + UMI_DSI_HDR_DLEN_OFF + 1];
+		const u8 *pl = &seq[i + UMI_DSI_HDR_LEN];
+		int ret;
+
+		if (i + UMI_DSI_HDR_LEN + plen > len) {
+			dev_err(&ctx->dsi->dev,
+				"%s: overrun at offset %d (dtype 0x%02x dlen %u)\n",
+				what, i, dtype, plen);
+			return -EINVAL;
+		}
+
+		/*
+		 * ★ 没有 reset-gpios 时，绝对不能发 sleep-in (DCS 0x10)。
+		 *
+		 *   面板进 sleep 之后必须靠硬件复位脉冲才能可靠唤醒 ——
+		 *   实测：熄屏再亮只发 sleep-out 的话，屏会亮几秒然后自我保护关掉。
+		 *   GPIO12 在 TLMM NORTH tile，那边寄存器读一下就 synchronous
+		 *   external abort，所以现在拿不到 reset。既然如此就别让它睡：
+		 *   只发 display-off (0x28)，面板保持 sleep-out 状态，下次
+		 *   prepare 直接重发 init 序列就能亮。
+		 */
+		if (!ctx->reset_gpio && dtype == DT_DCS_WRITE && plen >= 1 &&
+		    pl[0] == 0x10 /* MIPI_DCS_ENTER_SLEEP_MODE */) {
+			nskip++;
+			i += UMI_DSI_HDR_LEN + plen;
+			npkt++;
+			continue;
+		}
+
+		ret = umi_panel_send_one(ctx, dtype, pl, plen);
+		if (ret < 0) {
+			dev_err(&ctx->dsi->dev,
+				"%s: packet %d dtype 0x%02x failed (%d)\n",
+				what, npkt, dtype, ret);
+			return ret;
+		}
+
+		if (wait)
+			msleep(wait);
+
+		i += UMI_DSI_HDR_LEN + plen;
+		npkt++;
+	}
+
+	dev_info(&ctx->dsi->dev, "%s: sent %d packets / %d bytes%s\n",
+		 what, npkt, i, nskip ? " (sleep-in skipped: no reset, cannot wake)" : "");
+	if (i != len)
+		dev_warn(&ctx->dsi->dev, "%s: %d trailing bytes not parsed\n",
+			 what, len - i);
+	return 0;
+}
+
+/* ------------------------------------------------------------------ DSC */
+
+static int umi_panel_setup_dsc(struct umi_panel *ctx)
+{
+	struct drm_dsc_config *dsc = &ctx->cfg.dsc_cfg;
+	struct umi_panel_cfg *c = &ctx->cfg;
+	u32 ver;
+
+	if (!c->dsc)
+		return 0;
+
+	if (!c->dsc_slice_width || !c->dsc_slice_height) {
+		dev_err(&ctx->dsi->dev, "DSC: missing slice dimensions\n");
+		return -EINVAL;
+	}
+
+	ver = c->dsc_version ? c->dsc_version : 0x11;
+	memset(dsc, 0, sizeof(*dsc));
+	dsc->dsc_version_major = (ver >> 4) & 0xf;
+	dsc->dsc_version_minor = ver & 0xf;
+	dsc->slice_width = c->dsc_slice_width;
+	dsc->slice_height = c->dsc_slice_height;
+	dsc->slice_count = DIV_ROUND_UP(c->width, c->dsc_slice_width);
+	dsc->bits_per_component = c->dsc_bpc ? c->dsc_bpc : 8;
+	/*
+	 * 主线 drm_dsc_config 里 bits_per_pixel 是 4.4 定点数，
+	 * 整数部分等于下游 qcom,mdss-dsc-bit-per-pixel。
+	 * msm 的 dsi_populate_dsc_params() 要求低 4 位为 0，
+	 * 并且只支持 bits_per_component == 8。
+	 */
+	dsc->bits_per_pixel = (c->dsc_bpp ? c->dsc_bpp : 8) << 4;
+	dsc->block_pred_enable = c->dsc_block_pred;
+
+	/* 交给 msm dsi_host：dsi_host_attach() 里 msm_host->dsc = dsi->dsc */
+	ctx->dsi->dsc = dsc;
+
+	dev_info(&ctx->dsi->dev,
+		 "DSC: v%u.%u slice %ux%u count %u, %ubpc -> %ubpp (bpp_int %u), block_pred=%u\n",
+		 dsc->dsc_version_major, dsc->dsc_version_minor,
+		 dsc->slice_width, dsc->slice_height, dsc->slice_count,
+		 dsc->bits_per_component, c->dsc_bpp ?: 8,
+		 drm_dsc_get_bpp_int(dsc), dsc->block_pred_enable);
+	return 0;
+}
+
+static int umi_panel_send_dsc(struct umi_panel *ctx)
+{
+	struct drm_dsc_picture_parameter_set pps;
+	int ret;
+
+	ret = mipi_dsi_compression_mode(ctx->dsi, true);
+	if (ret < 0)
+		return ret;
+
+	drm_dsc_pps_payload_pack(&pps, &ctx->cfg.dsc_cfg);
+	return mipi_dsi_picture_parameter_set(ctx->dsi, &pps);
+}
+
+/* ------------------------------------------------------------------ 上电时序 */
+
+static int umi_panel_power_off(struct umi_panel *ctx)
+{
+	if (ctx->reset_gpio)
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+
+	if (ctx->num_supplies)
+		regulator_bulk_disable(ctx->num_supplies, ctx->supplies);
+	return 0;
+}
+
+static int umi_panel_power_on(struct umi_panel *ctx)
+{
+	int ret;
+
+	/* ★ 只 enable，不改电压；DTS 里不给 supply-names 时这里什么都不做 */
+	if (ctx->num_supplies) {
+		ret = regulator_bulk_enable(ctx->num_supplies, ctx->supplies);
+		if (ret)
+			return ret;
+	}
+
+	if (ctx->reset_gpio) {
+		/*
+		 * 下游 dsi_panel_reset() 的语义：reset-sequence 是
+		 *   <电平 延时ms 电平 延时ms 电平 延时ms ...>
+		 * 逐对执行。这块屏是 <1 1  0 1  1 10>：
+		 *   高 1ms -> 低 1ms（复位有效）-> 高 10ms（释放并静置）
+		 * 最后那 10ms 是关键：释放后不等就开始发 DCS，面板会全部丢掉。
+		 */
+		int i, n = ctx->cfg.reset_seq_len;
+
+		if (n >= 2) {
+			for (i = 0; i + 1 < n; i += 2) {
+				gpiod_set_value_cansleep(ctx->reset_gpio,
+							 ctx->cfg.reset_seq[i] ? 1 : 0);
+				msleep(ctx->cfg.reset_seq[i + 1] ?: 1);
+			}
+			dev_info(&ctx->dsi->dev,
+				 "reset sequence done: %d steps (hi %ums, lo %ums, hi %ums)\n",
+				 n / 2,
+				 ctx->cfg.reset_seq_len > 1 ? ctx->cfg.reset_seq[1] : 0,
+				 ctx->cfg.reset_seq_len > 3 ? ctx->cfg.reset_seq[3] : 0,
+				 ctx->cfg.reset_seq_len > 5 ? ctx->cfg.reset_seq[5] : 0);
+		} else {
+			/* DT 没给 reset-sequence 时的保守默认 */
+			gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+			msleep(1);
+			gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+			msleep(10);
+			dev_info(&ctx->dsi->dev, "reset sequence: default low 1ms -> high 10ms\n");
+		}
+	} else {
+		dev_warn(&ctx->dsi->dev,
+			 "no reset-gpios (GPIO12 lives in the TLMM NORTH tile, unreadable for now), "
+			 "skipping the reset pulse and using whatever state ABL left\n");
+	}
+	return 0;
+}
+
+/* ------------------------------------------------------------------ drm_panel */
+
+static int umi_panel_prepare(struct drm_panel *panel)
+{
+	struct umi_panel *ctx = to_umi_panel(panel);
+	int ret;
+
+	dev_info(&ctx->dsi->dev, "prepare %ux%u@%uHz%s%s\n",
+		 ctx->cfg.width, ctx->cfg.height, ctx->cfg.framerate,
+		 ctx->cfg.dsc ? " (DSC)" : "",
+		 ctx->cfg.no_init ? " [no-init]" : "");
+
+	if (ctx->cfg.no_init) {
+		dev_info(&ctx->dsi->dev,
+			 "no-init: verifying DPU/DSI/PHY path only, panel untouched\n");
+		return 0;
+	}
+
+	ret = umi_panel_power_on(ctx);
+	if (ret)
+		return ret;
+
+	if (ctx->cfg.dsc) {
+		ret = umi_panel_send_dsc(ctx);
+		if (ret) {
+			dev_err(&ctx->dsi->dev, "DSC enable failed (%d)\n", ret);
+			goto err_off;
+		}
+	}
+
+	ret = umi_panel_send_seq(ctx, "on-sequence",
+				 ctx->cfg.on_seq, ctx->cfg.on_seq_len);
+	if (ret)
+		goto err_off;
+
+	return 0;
+
+err_off:
+	umi_panel_power_off(ctx);
+	return ret;
+}
+
+static int umi_panel_enable(struct drm_panel *panel)
+{
+	struct umi_panel *ctx = to_umi_panel(panel);
+
+	if (ctx->cfg.no_init)
+		return 0;
+
+	/*
+	 * ★ 这里**不要**再自己往面板写 bl_min。
+	 *   backlight_enable() 会走 backlight_update_status() -> umi_panel_bl_update()，
+	 *   那里用的是 backlight core 里记住的亮度（首次就是 DT 的 bl-min）。
+	 *   以前这里多写了一次 "set_display_brightness(bl_min)"，结果是
+	 *   熄屏再亮之后把用户设的亮度（比如 400）又按回 1 —— 屏幕看起来是黑的。
+	 */
+	if (ctx->bl)
+		backlight_enable(ctx->bl);
+
+	return 0;
+}
+
+static int umi_panel_disable(struct drm_panel *panel)
+{
+	struct umi_panel *ctx = to_umi_panel(panel);
+
+	if (ctx->cfg.no_init)
+		return 0;
+
+	if (ctx->bl)
+		backlight_disable(ctx->bl);
+	return 0;
+}
+
+static int umi_panel_unprepare(struct drm_panel *panel)
+{
+	struct umi_panel *ctx = to_umi_panel(panel);
+
+	if (ctx->cfg.no_init)
+		return 0;
+
+	umi_panel_send_seq(ctx, "off-sequence",
+			   ctx->cfg.off_seq, ctx->cfg.off_seq_len);
+	msleep(20);
+	umi_panel_power_off(ctx);
+	return 0;
+}
+
+static int umi_panel_get_modes(struct drm_panel *panel,
+			       struct drm_connector *connector)
+{
+	struct umi_panel *ctx = to_umi_panel(panel);
+	struct drm_display_mode *mode;
+	u32 ht = ctx->cfg.width + ctx->cfg.hfp + ctx->cfg.hbp + ctx->cfg.hpw;
+	u32 vt = ctx->cfg.height + ctx->cfg.vfp + ctx->cfg.vbp + ctx->cfg.vpw;
+
+	if (!ctx->cfg.width || !ctx->cfg.height || !vt)
+		return -EINVAL;
+
+	mode = drm_mode_create(connector->dev);
+	if (!mode)
+		return -ENOMEM;
+
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	mode->clock = DIV_ROUND_CLOSEST(ht * vt * ctx->cfg.framerate, 1000);
+	mode->hdisplay = ctx->cfg.width;
+	mode->hsync_start = mode->hdisplay + ctx->cfg.hfp;
+	mode->hsync_end = mode->hsync_start + ctx->cfg.hpw;
+	mode->htotal = mode->hsync_end + ctx->cfg.hbp;
+	mode->vdisplay = ctx->cfg.height;
+	mode->vsync_start = mode->vdisplay + ctx->cfg.vfp;
+	mode->vsync_end = mode->vsync_start + ctx->cfg.vpw;
+	mode->vtotal = mode->vsync_end + ctx->cfg.vbp;
+	drm_mode_set_name(mode);
+
+	connector->display_info.width_mm = ctx->cfg.width_mm;
+	connector->display_info.height_mm = ctx->cfg.height_mm;
+
+	dev_info(&ctx->dsi->dev, "mode: %ux%u@%u, %ux%u total, %u kHz\n",
+		 mode->hdisplay, mode->vdisplay, ctx->cfg.framerate,
+		 mode->htotal, mode->vtotal, mode->clock);
+
+	drm_mode_probed_add(connector, mode);
+	return 1;
+}
+
+static const struct drm_panel_funcs umi_panel_funcs = {
+	.prepare	= umi_panel_prepare,
+	.enable		= umi_panel_enable,
+	.disable	= umi_panel_disable,
+	.unprepare	= umi_panel_unprepare,
+	.get_modes	= umi_panel_get_modes,
+};
+
+/* ------------------------------------------------------------------ 背光 */
+
+static int umi_panel_bl_update(struct backlight_device *bl)
+{
+	struct umi_panel *ctx = bl_get_data(bl);
+	u32 level;
+
+	if (ctx->cfg.no_init)
+		return 0;
+
+	level = clamp_t(u32, backlight_get_brightness(bl),
+			ctx->cfg.bl_min ?: 1, ctx->cfg.bl_max ?: 0x7ff);
+	return mipi_dsi_dcs_set_display_brightness(ctx->dsi, level);
+}
+
+static const struct backlight_ops umi_panel_bl_ops = {
+	.update_status = umi_panel_bl_update,
+};
+
+/*
+ * 面板 IC 的调试口。
+ *
+ *   echo 52     > dbg    用 DCS 回读面板寄存器（0x52 是当前亮度）
+ *   echo da     > dbg    回读面板 ID
+ *   echo 1      > kick   强制重发一次亮度命令
+ *
+ * 背光是走 DCS 0x51 写进面板 IC 的，没有外部 PWM/WLED，所以 sysfs 里的
+ * brightness 只是软件值，并不证明命令送达。屏幕黑的时候必须能读到面板里
+ * 到底存了什么，才能分清「亮度没写进去」和「面板根本没工作」。
+ */
+static ssize_t umi_panel_dbg_store(struct device *dev,
+				   struct device_attribute *attr,
+				   const char *buf, size_t count)
+{
+	struct mipi_dsi_device *dsi = to_mipi_dsi_device(dev);
+	struct umi_panel *ctx = mipi_dsi_get_drvdata(dsi);
+	unsigned int cmd = 0, cnt = 1;
+	u8 tmp[16] = { 0 };
+	int ret, len;
+
+	if (sscanf(buf, "%x %x", &cmd, &cnt) < 1 || cmd > 0xff)
+		return -EINVAL;
+	if (cnt < 1 || cnt > sizeof(tmp))
+		cnt = 1;
+
+	ret = mipi_dsi_dcs_read(ctx->dsi, cmd, tmp, cnt);
+	len = ret > 0 ? ret : 0;
+	dev_info(dev, "dcs r %02x -> %d %*ph\n", cmd, ret, len, tmp);
+
+	return count;
+}
+static DEVICE_ATTR(dbg, 0200, NULL, umi_panel_dbg_store);
+
+static ssize_t umi_panel_kick_store(struct device *dev,
+				    struct device_attribute *attr,
+				    const char *buf, size_t count)
+{
+	struct mipi_dsi_device *dsi = to_mipi_dsi_device(dev);
+	struct umi_panel *ctx = mipi_dsi_get_drvdata(dsi);
+	int level, ret;
+
+	level = backlight_get_brightness(ctx->bl);
+	ret = mipi_dsi_dcs_set_display_brightness(ctx->dsi, level);
+	dev_info(dev, "kick brightness %d -> %d\n", level, ret);
+
+	return count;
+}
+static DEVICE_ATTR(kick, 0200, NULL, umi_panel_kick_store);
+
+/*
+ * Rescue hatch for a black panel.
+ *
+ * The touch controller shares the 3.3 V vddio rail (disp_vddio_vreg) and the
+ * flex with the command mode AMOLED.  A rough touch command sequence can leave
+ * the panel dark while the SoC keeps scanning the framebuffer happily, and
+ * until now the only way back was a reboot.  The on-sequence is just 59 DCS
+ * packets, so re-sending it is cheap:
+ *
+ *   echo 1 > repower
+ *
+ * If the panel comes back with this, the display pipeline was fine all along
+ * and only the panel IC had been knocked over.
+ */
+static ssize_t umi_panel_repower_store(struct device *dev,
+				       struct device_attribute *attr,
+				       const char *buf, size_t count)
+{
+	struct mipi_dsi_device *dsi = to_mipi_dsi_device(dev);
+	struct umi_panel *ctx = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	dev_info(dev, "repower: re-sending on-sequence (%d bytes)\n",
+		 ctx->cfg.on_seq_len);
+
+	ret = umi_panel_send_seq(ctx, "on-sequence",
+				 ctx->cfg.on_seq, ctx->cfg.on_seq_len);
+	dev_info(dev, "repower: on-sequence -> %d\n", ret);
+
+	if (ctx->bl)
+		backlight_enable(ctx->bl);
+
+	return ret ? ret : count;
+}
+static DEVICE_ATTR(repower, 0200, NULL, umi_panel_repower_store);
+
+/*
+ * 运行时 DSI poke（和触摸那边的 cmd 盒子对应）。
+ *
+ *   echo "39 01 00 00 00 00 06 F0 55 AA 52 08 01" > dsi
+ *
+ * 数据按下游格式写：7 字节头 {dtype, last, vc, ack, wait, dlen_hi, dlen_lo}
+ * 加 payload，可以一次写多包。这样面板侧的实验（VI setting、ELVSS、
+ * gamma、亮度补偿）就不用每次重新编译内核了。
+ *
+ * 为什么需要它：MIUI 的面板驱动会在运行时按亮度/温度下发 mi,mdss-dsi-vi-setting-*
+ * （page 1 的 B9 0x1A/0x1F）和 dynamic ELVSS，我们的驱动一个都不发；而触摸
+ * 传感器的参考电位就是面板的阴极，这是目前唯一还没对齐的软件变量。
+ */
+static ssize_t umi_panel_dsi_store(struct device *dev,
+				   struct device_attribute *attr,
+				   const char *buf, size_t count)
+{
+	struct mipi_dsi_device *dsi = to_mipi_dsi_device(dev);
+	struct umi_panel *ctx = mipi_dsi_get_drvdata(dsi);
+	const char *p = buf;
+	unsigned int v;
+	u8 seq[512];
+	int n = 0, ret;
+
+	while (n < (int)sizeof(seq) && sscanf(p, "%x", &v) == 1) {
+		seq[n++] = v & 0xff;
+		while (*p && *p != ' ' && *p != '\t' && *p != '\n')
+			p++;
+		while (*p == ' ' || *p == '\t')
+			p++;
+	}
+
+	if (!n)
+		return -EINVAL;
+
+	ret = umi_panel_send_seq(ctx, "dsi poke", seq, n);
+	dev_info(dev, "dsi poke: %d bytes -> %d\n", n, ret);
+
+	return ret ? ret : count;
+}
+static DEVICE_ATTR(dsi, 0200, NULL, umi_panel_dsi_store);
+
+/* ------------------------------------------------------------------ DT */
+
+static int umi_panel_parse_dt(struct umi_panel *ctx)
+{
+	struct device *dev = &ctx->dsi->dev;
+	struct device_node *np = dev->of_node;
+	struct umi_panel_cfg *c = &ctx->cfg;
+	int ret;
+
+	ret = of_property_read_u32(np, "xiaomi,panel-width", &c->width);
+	if (ret)
+		return dev_err_probe(dev, ret, "missing xiaomi,panel-width\n");
+	ret = of_property_read_u32(np, "xiaomi,panel-height", &c->height);
+	if (ret)
+		return dev_err_probe(dev, ret, "missing xiaomi,panel-height\n");
+
+	of_property_read_u32(np, "xiaomi,framerate", &c->framerate);
+	of_property_read_u32(np, "xiaomi,h-front-porch", &c->hfp);
+	of_property_read_u32(np, "xiaomi,h-back-porch", &c->hbp);
+	of_property_read_u32(np, "xiaomi,h-pulse-width", &c->hpw);
+	of_property_read_u32(np, "xiaomi,h-sync-skew", &c->hskew);
+	of_property_read_u32(np, "xiaomi,v-front-porch", &c->vfp);
+	of_property_read_u32(np, "xiaomi,v-back-porch", &c->vbp);
+	of_property_read_u32(np, "xiaomi,v-pulse-width", &c->vpw);
+	of_property_read_u32(np, "xiaomi,physical-width-mm", &c->width_mm);
+	of_property_read_u32(np, "xiaomi,physical-height-mm", &c->height_mm);
+	of_property_read_u32(np, "xiaomi,clockrate", &c->clockrate);
+	of_property_read_u32(np, "xiaomi,bl-min", &c->bl_min);
+	of_property_read_u32(np, "xiaomi,bl-max", &c->bl_max);
+
+	of_property_read_u32_array(np, "xiaomi,panel-id", c->panel_id, 2);
+
+	c->on_seq = of_get_property(np, "xiaomi,on-seq", &c->on_seq_len);
+	c->off_seq = of_get_property(np, "xiaomi,off-seq", &c->off_seq_len);
+
+	/*
+	 * ★ 必须按 u32 读！DT 里是大端 32 位单元，按字节读全是 0
+	 *   （<0x00000001 ...> 的字节是 00 00 00 01，reset_seq[0] 会变成 0，
+	 *    结果就是「拉低 0ms、拉高 0ms」，面板根本没复位）。
+	 *
+	 * ★ 也不能直接 of_property_read_u32_array(np, prop, arr, ARRAY_SIZE(arr))：
+	 *   属性元素比数组短时它返回 -EOVERFLOW，于是 length 变 0、整段被跳过。
+	 *   实测就是这样掉进了 "default low 1ms -> high 10ms" 分支。
+	 *   正确做法：先数元素个数，再按实际个数读。
+	 */
+	{
+		int n = of_property_count_u32_elems(np, "xiaomi,reset-sequence");
+		int rc;
+
+		if (n <= 0) {
+			c->reset_seq_len = 0;
+		} else {
+			n = min(n, (int)ARRAY_SIZE(c->reset_seq));
+			rc = of_property_read_u32_array(np, "xiaomi,reset-sequence",
+							c->reset_seq, n);
+			c->reset_seq_len = rc ? 0 : n;
+		}
+	}
+
+	/* qcom,compression-mode = "dsc" 被生成器改成了布尔属性 */
+	c->dsc = of_property_read_bool(np, "xiaomi,compression");
+	if (c->dsc) {
+		of_property_read_u32(np, "xiaomi,dsc-slice-width", &c->dsc_slice_width);
+		of_property_read_u32(np, "xiaomi,dsc-slice-height", &c->dsc_slice_height);
+		of_property_read_u32(np, "xiaomi,dsc-slice-per-pkt", &c->dsc_slice_per_pkt);
+		of_property_read_u32(np, "xiaomi,dsc-bpc", &c->dsc_bpc);
+		of_property_read_u32(np, "xiaomi,dsc-bpp", &c->dsc_bpp);
+		of_property_read_u32(np, "xiaomi,dsc-version", &c->dsc_version);
+		c->dsc_block_pred =
+			of_property_read_bool(np, "xiaomi,dsc-block-prediction");
+	}
+
+	c->no_init = of_property_read_bool(np, "xiaomi,no-init");
+
+	if (!c->framerate)
+		c->framerate = 60;
+
+	dev_info(dev, "panel-id %08x:%06x  %ux%u@%uHz  on-seq %dB  DSC=%d\n",
+		 c->panel_id[0], c->panel_id[1], c->width, c->height,
+		 c->framerate, c->on_seq_len, c->dsc);
+
+	if (c->no_init)
+		dev_warn(dev, "xiaomi,no-init set: probing only, panel untouched\n");
+	return 0;
+}
+
+/*
+ * NORTH TLMM tile 诊断。
+ *
+ * 面板的 reset 是 GPIO12、TE 是 GPIO66，两个都在 TLMM 的 north tile
+ * （sm8250.dtsi 里 reg 的第三段 0x0f900000）。这块在 umi 上整块被
+ * gpio-reserved-ranges 标成不可用，因为读它的寄存器会 synchronous external
+ * abort —— gpiochip 注册时读一次方向就把内核挂掉。
+ *
+ * 但"读不了"和"完全碰不到"是两件事：如果只是这块 tile 没上电/没时钟，
+ * 以后把它点亮就能拿回 GPIO12，面板「熄屏再亮需要复位脉冲」的问题也就解决了。
+ * 所以这里用 copy_from_kernel_nofault() 做一次**不会 oops** 的探测：
+ * 出错只是返回 -EFAULT，内核照常跑。
+ */
+/*
+ * NORTH TLMM tile 说明（★ 血泪教训，别再犯）
+ *
+ *   面板 reset = GPIO12、TE = GPIO66，都在 TLMM north tile（0x0f900000），
+ *   所以 sm8250-xiaomi-umi-common.dtsi 里用 gpio-reserved-ranges 把它们挡住了。
+ *
+ *   我曾经写过一个「用 copy_from_kernel_nofault 把 68 个 NORTH 引脚逐个读一遍」
+ *   的扫描诊断，结果**整机被看门狗复位**：copy_from_kernel_nofault 只能兜住
+ *   同步 external abort（有明确指令地址，走 extable 返回 -EFAULT），
+ *   而这块区域里有一部分访问产生的是 **SError（异步外部中止）**，
+ *   它无法归属到某条指令 -> 内核 panic -> CONFIG_QCOM_WDT 直接把机器重启
+ *   （PANIC_TIMEOUT=0 拦不住硬件看门狗）。
+ *
+ *   教训：
+ *     1) 想验证某个引脚是否可读，就**只读那一个**。实测 GPIO12 读回来
+ *        0x000002c3（mux=GPIO, OE=1, pull-up），是好的；
+ *     2) 不要批量探测 MMIO，失败的代价是整机重启而不是一条日志；
+ *     3) 现在 DTS 只把 pin 12 从 reserved 里放出来，其余保持不变。
+ */
+static void umi_log_north_note(struct device *dev)
+{
+	dev_info(dev, "NORTH TLMM: only gpio12(reset) freed, rest still reserved\n");
+}
+
+static int umi_panel_probe(struct mipi_dsi_device *dsi)
+{
+	struct umi_panel *ctx;
+	struct backlight_properties props;
+	int ret;
+
+	/*
+	 * 7.x 把 drm_panel_init() 换成了 devm_drm_panel_alloc()：panel 结构体
+	 * 内嵌在上下文里，由分配器一并初始化（含 funcs 和 connector_type）。
+	 * 它是宏，所以 #ifdef 可以拿来当特性探测，两个内核版本都能编。
+	 */
+#ifdef devm_drm_panel_alloc
+	ctx = devm_drm_panel_alloc(&dsi->dev, struct umi_panel, panel,
+				   &umi_panel_funcs, DRM_MODE_CONNECTOR_DSI);
+	if (!ctx)
+		return -ENOMEM;
+#else
+	ctx = devm_kzalloc(&dsi->dev, sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+#endif
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	ret = umi_panel_parse_dt(ctx);
+	if (ret)
+		return ret;
+
+	umi_log_north_note(&dsi->dev);
+
+	/*
+	 * 复位脚是**可选**的：DTS 里给了 reset-gpios 就拿到，拿不到也不能让
+	 * 整个 probe 失败 —— 没有 reset 面板照样能亮（ABL 已经点过一次），
+	 * 只是熄屏再亮那种需要复位脉冲的场景不成立。
+	 */
+	ctx->reset_gpio = devm_gpiod_get_optional(&dsi->dev, "reset",
+						  GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset_gpio)) {
+		dev_warn(&dsi->dev, "no reset-gpios (%ld), running without reset\n",
+			 PTR_ERR(ctx->reset_gpio));
+		ctx->reset_gpio = NULL;
+	}
+	if (ctx->reset_gpio)
+		dev_info(&dsi->dev, "reset-gpios acquired (needed to wake the panel)\n");
+	else
+		dev_warn(&dsi->dev,
+			 "reset-gpios unavailable (GPIO12 in TLMM NORTH tile), will skip sleep-in\n");
+
+	/*
+	 * ★ 只按名字取已有的轨，**不设任何电压**。
+	 *   umi 默认不在 DTS 里给这个属性 —— 屏供电 ABL 已经打开，内核不碰。
+	 */
+	ctx->num_supplies = of_property_count_strings(dsi->dev.of_node,
+						     "xiaomi,supply-names");
+	if (ctx->num_supplies > 0) {
+		int i;
+
+		ctx->supplies = devm_kcalloc(&dsi->dev, ctx->num_supplies,
+					     sizeof(*ctx->supplies), GFP_KERNEL);
+		if (!ctx->supplies)
+			return -ENOMEM;
+		for (i = 0; i < ctx->num_supplies; i++) {
+			const char *name;
+
+			of_property_read_string_index(dsi->dev.of_node,
+						      "xiaomi,supply-names", i, &name);
+			ctx->supplies[i].supply = name;
+		}
+		ret = devm_regulator_bulk_get(&dsi->dev, ctx->num_supplies,
+					      ctx->supplies);
+		if (ret)
+			return dev_err_probe(&dsi->dev, ret, "supply not found\n");
+	}
+
+	ret = umi_panel_setup_dsc(ctx);
+	if (ret)
+		return ret;
+
+#ifndef devm_drm_panel_alloc
+	drm_panel_init(&ctx->panel, &dsi->dev, &umi_panel_funcs,
+		       DRM_MODE_CONNECTOR_DSI);
+#endif
+	ctx->panel.prepare_prev_first = true;
+	drm_panel_add(&ctx->panel);
+
+	memset(&props, 0, sizeof(props));
+	props.type = BACKLIGHT_RAW;
+	props.max_brightness = ctx->cfg.bl_max ?: 0x7ff;
+	props.brightness = ctx->cfg.bl_min ?: 1;	/* ★ 起始最低亮度 */
+	ctx->bl = devm_backlight_device_register(&dsi->dev, "umi-panel",
+						 &dsi->dev, ctx, &umi_panel_bl_ops,
+						 &props);
+	if (IS_ERR(ctx->bl))
+		return dev_err_probe(&dsi->dev, PTR_ERR(ctx->bl), "backlight registration failed\n");
+
+	/*
+	 * ★ 这块屏是 dsi_cmd_mode（下游 qcom,mdss-dsi-panel-type = "dsi_cmd_mode"），
+	 *   所以**绝对不能**带 MIPI_DSI_MODE_VIDEO 系列标志：
+	 *   msm_dsi_is_cmd_mode() 就是靠 !(mode_flags & MIPI_DSI_MODE_VIDEO) 判断的，
+	 *   带上 VIDEO_BURST 会走 video 编码器 + DPU 视频时序，命令模式面板点不亮。
+	 *   下游还有 qcom,mdss-dsi-tx-eot-append（发 EOT 包），所以也不要
+	 *   MIPI_DSI_MODE_NO_EOT_PACKET。
+	 */
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_LPM | MIPI_DSI_CLOCK_NON_CONTINUOUS;
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret) {
+		drm_panel_remove(&ctx->panel);
+		return ret;
+	}
+
+	dev_info(&dsi->dev, "panel attached (4 lane, cmd mode, RGB888)\n");
+
+	/*
+	 * 触摸驱动要等面板起来之后再开始采样。MIUI 上时序是「面板 1s、触摸 3.9s」，
+	 * 我们是「触摸 6.5s、面板 6.8s」，AFE 在 VCOM/ELVSS 建立之前就开始采，
+	 * 结果每一帧都被固件判废（STATUS/FRAME_DROP）。这个标志让触摸 probe 用
+	 * -EPROBE_DEFER 排队到面板就绪之后。
+	 */
+	WRITE_ONCE(umi_panel_ready, true);
+
+	device_create_file(&dsi->dev, &dev_attr_dbg);
+	device_create_file(&dsi->dev, &dev_attr_kick);
+	device_create_file(&dsi->dev, &dev_attr_repower);
+	device_create_file(&dsi->dev, &dev_attr_dsi);
+
+	return 0;
+}
+
+static void umi_panel_remove(struct mipi_dsi_device *dsi)
+{
+	struct umi_panel *ctx = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id umi_panel_of_match[] = {
+	{ .compatible = "xiaomi,umi-panel" },

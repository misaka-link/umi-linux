			0x6f 0x05 0x39 0x01 0x00 0x00 0x00 0x00 0x03 0xfd 0x00 0xda 0x39 0x01 0x00 0x00
			0x00 0x00 0x05 0xff 0xaa 0x55 0xa5 0x80 0x15 0x00 0x00 0x00 0x00 0x00 0x02 0x6f
			0x0a 0x15 0x01 0x00 0x00 0x00 0x00 0x02 0xfc 0x02 0x15 0x01 0x00 0x00 0x00 0x00

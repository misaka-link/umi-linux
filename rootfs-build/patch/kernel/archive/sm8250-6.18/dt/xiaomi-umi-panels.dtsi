			0x36 0x0a 0x15 0x01 0x00 0x00 0x00 0x00 0x02 0x2f 0x01 0x15 0x01 0x00 0x00 0x00
			0x00 0x02 0x26 0x01 0x05 0x01 0x00 0x00 0x64 0x00 0x02 0x11 0x00 0x05 0x01 0x00
			0x00 0x00 0x00 0x02 0x29 0x00 0x39 0x01 0x00 0x00 0x00 0x00 0x06 0xf0 0x55 0xaa
			0x52 0x08 0x00 0x15 0x01 0x00 0x00 0x00 0x00 0x02 0xb5 0x84>;
		xiaomi,off-seq = /bits/ 8 <0x05 0x01 0x00 0x00 0x00 0x00 0x02 0x28 0x00 0x05 0x01 0x00 0x00 0x78 0x00 0x02
			0x10 0x00>;
		xiaomi,compression = "dsc";
		xiaomi,dsc-version = <0x11>;
		xiaomi,dsc-slice-height = <0x0c>;
		xiaomi,dsc-slice-width = <0x21c>;
		xiaomi,dsc-slice-per-pkt = <0x02>;
		xiaomi,dsc-bpc = <0x08>;
		xiaomi,dsc-bpp = <0x08>;
		xiaomi,dsc-block-prediction;
		xiaomi,phy-timings = [00 18 06 06 21 20 06 06 04 02 04 00 15 16];

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				umi_panel_in: endpoint {
					remote-endpoint = <&mdss_dsi0_out>;
				};
			};
		};
	};
};

&mdss_dsi0_out {
	data-lanes = <0 1 2 3>;	/* 下游 lane-0..3-state 全开 => 4 lane DPHY */
	remote-endpoint = <&umi_panel_in>;
};
